<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="xin.pwdkeeper.wechat.mapper.FileDataInfoMapper">

    <!-- 添加 resultMap 定义 -->
    <resultMap id="FileDataInfoResultMap" type="xin.pwdkeeper.wechat.bean.FileDataInfo">
        <id property="id" column="id"/>
        <result property="openId" column="open_id"/>
        <result property="fileName" column="file_name"/>
        <result property="fileUrl" column="file_url"/>
        <result property="fileBucketName" column="file_bucket_name"/>
        <result property="creationTime" column="creation_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="flag" column="flag"/>
    </resultMap>

    <!-- 添加公共的查询字段 -->
    <sql id="selectFileDataInfo">
        id, open_id, file_name, file_url, file_bucket_name, creation_time, update_time, flag
    </sql>

    <select id="selectById" resultMap="FileDataInfoResultMap">
        SELECT <include refid="selectFileDataInfo"/> FROM file_data_info WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="FileDataInfoResultMap">
        SELECT <include refid="selectFileDataInfo"/> FROM file_data_info
    </select>
    <select id="selectByOpenId" resultMap="FileDataInfoResultMap">
        SELECT id, file_name, file_url, file_bucket_name, creation_time, update_time
        FROM file_data_info 
        WHERE open_id = #{openId} and flag = 1
        ORDER BY update_time DESC
        LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO file_data_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="openId != null">open_id,</if>
            <if test="fileName != null">file_name,</if>
            <if test="fileUrl != null">file_url,</if>
            <if test="fileBucketName != null">file_bucket_name,</if>
            <if test="creationTime != null">creation_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="flag != null">flag,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="openId != null">#{openId},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="fileUrl != null">#{fileUrl},</if>
            <if test="fileBucketName != null">#{fileBucketName},</if>
            <if test="creationTime != null">#{creationTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="flag != null">#{flag},</if>
        </trim>
    </insert>

    <update id="update">
        UPDATE file_data_info
        SET open_id = #{openId}, file_name = #{fileName}, file_url = #{fileUrl},
            file_bucket_name = #{fileBucketName}, update_time = #{updateTime}, flag = #{flag}
        WHERE id = #{id}
    </update>
    <update id="updateFlagStatus">
        UPDATE file_data_info SET flag = 0 WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM file_data_info WHERE id = #{id}
    </delete>

</mapper>